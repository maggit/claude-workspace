{
  "name": "@maggit/claude-workspace",
  "version": "1.0.2",
  "description": "CLI tool to scaffold Claude workspaces into any project",
  "type": "module",
  "license": "MIT",
  "author": "Raquel Hernandez",
  "repository": {
    "type": "git",
    "url": "https://github.com/maggit/claude-workspace.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/maggit/claude-workspace",
  "keywords": [
    "claude",
    "ai",
    "workspace",
    "scaffold",
    "markdown",
    "llm",
    "cli",
    "dotfiles",
    "context",
    "templates"
  ],
  "bin": {
